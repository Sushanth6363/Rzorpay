# Unified Recovery Engine — environment template
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#   cp .env.example .env
#
# Nothing here is required to run `make test` or `make eval` — the batch evaluation is
# fully offline. These variables only matter for the LIVE path: real payment links, real
# messages, and real webhooks.

ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------
# SAFETY GATES — both default to OFF. Nothing reaches a real person until you change them.
# ---------------------------------------------------------------------------------------

# false = the engine decides and records a full audit trail, but SENDS NOTHING.
# This is the default, and it is what tests run under.
RECOVERY_DISPATCH_ENABLED=false

# A SECOND, independent gate. Even with dispatch enabled, a live (rzp_live_) key is
# refused unless this is also set. Test keys (rzp_test_) do not need it.
RECOVERY_ALLOW_LIVE_CREDENTIALS=false

# ---------------------------------------------------------------------------------------
# RAZORPAY — Test Mode is the demo environment
# ---------------------------------------------------------------------------------------
# Dashboard (TEST MODE) -> Account & Settings -> API Keys -> Generate Test Key.
# The secret is shown ONCE; download it there and then.
#
# NOTE: `rzp_test_mock...` is the placeholder the code treats as "not configured" and will
# refuse to create links with. A real test key looks like rzp_test_AbCdEf1234567890.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# You CHOOSE this string yourself, then paste the identical value into the Razorpay
# dashboard when creating the webhook. A mismatch means every webhook returns 401.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RAZORPAY_WEBHOOK_SECRET=

# Reject webhooks older than this many seconds (replay protection).
WEBHOOK_MAX_AGE_SECONDS=300

# LOCAL TESTING ONLY. Accepts unsigned webhooks so you can curl the endpoint.
# Leave false for anything reachable from the internet — an unauthenticated endpoint
# that mints payment links lets anyone make your engine contact strangers.
ALLOW_UNSIGNED_WEBHOOKS=false

# ---------------------------------------------------------------------------------------
# EMAIL — first real channel
# ---------------------------------------------------------------------------------------
# Gmail requires an APP PASSWORD, not your account password. 2-Step Verification must be
# on first: myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# The app password is 16 characters; paste it without spaces.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------------------
# TWILIO — SMS, WhatsApp, and the IVR voice call (optional)
# ---------------------------------------------------------------------------------------
# console.twilio.com -> Account Info. The trial account can only message numbers you have
# verified, and the WhatsApp sandbox only delivers to numbers that have joined it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=

# ---------------------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------------------
# One WAL SQLite file shared by the webhook server, the scheduler and the dashboard.
RECOVERY_DB_PATH=data/recovery.db

# ---------------------------------------------------------------------------------------
# PUBLIC TUNNEL (Terminal 2)
# ---------------------------------------------------------------------------------------
# Your ngrok reserved domain, claimed once at https://dashboard.ngrok.com/domains.
# Recorded here so scripts/start_tunnel.ps1 has nothing left to substitute - every time
# this value lived in a document as a placeholder, the placeholder got pasted verbatim.
# The Razorpay webhook URL is then https://$NGROK_DOMAIN/webhooks/razorpay
NGROK_DOMAIN=

# ---------------------------------------------------------------------------------------
# WHO CONTACTS THE CUSTOMER
# ---------------------------------------------------------------------------------------
# "engine"   (default) the engine owns contact. Razorpay creates the link and sends
#            nothing, so every message passes ChannelDispatcher and lands in the ledger,
#            and the escalation ladder, contact budget and quiet period actually hold.
# "razorpay" Razorpay delivers the link by email and SMS itself, and the dispatcher does
#            NOT also send that rung. Useful for a real SMS with no Twilio account.
#            Voice/IVR stays with the engine either way - Razorpay does not place calls.
RECOVERY_LINK_NOTIFY=engine
